{
  "name": "smarthub",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:analyze": "vite build --mode production && vite-bundle-visualizer",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,css,json,md}\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:strict": "tsc -p tsconfig.app.json --noEmit --strict --noUncheckedIndexedAccess",
    "verify": "bun run typecheck && bun run lint && bun run lint:budget && bun run format:check && bun run test",
    "verify:full": "bun run typecheck && bun run lint && bun run lint:budget && bun run format:check && bun run test && bun run test:coverage && bun run audit:security && bun run e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --browser.headless",
    "test:a11y": "vitest run --dir src/test/a11y",
    "e2e": "playwright test",
    "e2e:a11y": "playwright test --grep @a11y",
    "e2e:perf": "playwright test --grep @perf",
    "lint:budget": "node scripts/lint-budget.mjs",
    "audit:security": "eslint --plugin security --rule '\"security/detect-object-injection\": \"error\"' --no-eslintrc --parser @typescript-eslint/parser src",
    "prepare": "husky || true",
    "postinstall": "node -e \"console.log('amv.life // Smarthub — Zen Elite ready')\"",
    "size": "bun run build && du -sh dist",
    "analyze": "vite-bundle-visualizer"
  },
