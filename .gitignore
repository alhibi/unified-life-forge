# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# This project uses bun.lock (text format). The legacy binary bun.lockb
# and npm's package-lock.json are intentionally NOT tracked — committing
# them in parallel led to three-way drift between package managers.
bun.lockb
package-lock.json
yarn.lock
pnpm-lock.yaml

# Test/build artefacts
playwright-report
test-results
coverage

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# Local env files (committed values may leak secrets — keep `.env.example` instead)
.env
.env.local
.env.*.local
