# Supabase — these MUST be set or the app will throw at startup.
# Copy this file to `.env` and fill in the project-specific values.
# (The actual `.env` is gitignored.)

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Edge-function / server-side variants (used by `supabase/functions`).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Service-role key — used ONLY by server-side ingestion scripts in
# scripts/diwan/ingest.ts to upsert into Supabase tables. NEVER ship
# this to the browser or commit it: it bypasses RLS entirely.
# Required only if you actually run the diwan ingest pipeline.
SUPABASE_SERVICE_ROLE_KEY=
