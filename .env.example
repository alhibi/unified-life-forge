# ---------------------------------------------------------------------------
# Client-side env (Vite). Copy this file to `.env` and fill in real values.
# `.env` itself is gitignored.
#
# All client-readable variables MUST be prefixed `VITE_`. Anything without
# that prefix is invisible to the browser bundle and will silently be
# undefined at runtime.
#
# Both values below come from your Supabase project's API settings:
# https://supabase.com/dashboard/project/<your-project>/settings/api
#
# The app will start without these set, but every feature that talks to
# Supabase (auth, chat, wellness, RSS reader, etc.) will be unavailable
# and a warning will be logged to the console.
# ---------------------------------------------------------------------------

# Project URL (e.g. https://xyz.supabase.co)
VITE_SUPABASE_URL=

# Publishable / anon key. Safe to ship to the browser — RLS does the actual
# access control on the database side. NEVER paste a service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Edge-function env: NOT set here.
#
# Functions in `supabase/functions/` read their secrets from Supabase's
# runtime environment (`Deno.env.get(...)`). Common ones include
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY — set
# them with `supabase secrets set` (or via the dashboard), not in this file.
# ---------------------------------------------------------------------------
