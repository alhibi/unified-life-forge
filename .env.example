# ── Supabase ─────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the project-specific values.
# (The actual `.env` is gitignored.)
#
# These are OPTIONAL. This file used to say "these MUST be set or the app will
# throw at startup", which has not been true for a while:
# src/integrations/supabase/client.ts carries hard-coded fallbacks for the
# project URL and the publishable (anon) key, so with no `.env` the app silently
# talks to the default project instead of failing. Set them to point a fork
# somewhere else.
#
# VITE_SUPABASE_PUBLISHABLE_KEY must be the *publishable* (anon) key, never the
# service_role key — Vite inlines VITE_* into the public bundle, and a
# service_role key bypasses Row-Level Security entirely. client.ts decodes the
# key's role claim and refuses to start if it sees one, but the check is a
# backstop, not permission to be careless.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Edge-function / server-side variants (used by `supabase/functions`).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ── Error telemetry (optional) ───────────────────────────────────────
# When VITE_SENTRY_DSN is set, scrubbed uncaught errors, unhandled
# rejections and React render failures are forwarded to Sentry. Leave it
# empty and the SDK is never even downloaded — events stay in an in-memory
# ring buffer readable in the console via window.__telemetry().
VITE_SENTRY_DSN=
# Release tag attached to telemetry events. Defaults to "dev".
# Must match the release the source maps are uploaded under (see below), or
# Sentry will hold maps it never applies to the events that need them.
VITE_APP_VERSION=

# ── Source-map upload (CI only, optional) ─────────────────────────────
# The build always emits `sourcemap: 'hidden'` maps: without them every Sentry
# stack frame points into minified output at a column offset, which makes the
# drain write-only.
#
# Set all three and `bun run build` uploads the maps to Sentry and then deletes
# them from dist/, so the deployed artefact contains none. Set none and the
# build is unchanged — nginx.conf denies `.map` requests as the backstop.
#
# SENTRY_AUTH_TOKEN is a secret: keep it in CI, never in a committed .env.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Service-role key — used ONLY by server-side ingestion scripts in
# scripts/diwan/ingest.ts to upsert into Supabase tables. NEVER ship
# this to the browser or commit it: it bypasses RLS entirely.
# Required only if you actually run the diwan ingest pipeline.
SUPABASE_SERVICE_ROLE_KEY=
